<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/background_secondary">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="AI Interview Practice"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Track Selection View -->
            <LinearLayout
                android:id="@+id/layout_track_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Your Career Track"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose a domain to start a interactive mock interview with real-time AI scoring."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btn_track_android"
                    style="@style/Widget.KirigenPlatform.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Android Development Track"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_track_java"
                    style="@style/Widget.KirigenPlatform.Button.Navy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Java Backend Engineer Track"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_track_frontend"
                    style="@style/Widget.KirigenPlatform.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frontend Development Track"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>

            <!-- Interview Question View -->
            <LinearLayout
                android:id="@+id/layout_interview_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_track_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Android Development"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_question_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Question 1 of 5"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.KirigenPlatform.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/background_card">

                    <TextView
                        android:id="@+id/tv_question_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:text="What is the difference between Val and Var in Kotlin, and how does it relate to Java?"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.KirigenPlatform.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Type your response here...">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="4" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_submit_answer"
                    style="@style/Widget.KirigenPlatform.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Evaluate Response"
                    android:layout_marginBottom="16dp" />

                <ProgressBar
                    android:id="@+id/evaluation_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    android:indeterminateTint="@color/neon_cyan"
                    android:visibility="gone" />

                <!-- Feedback Panel -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_feedback"
                    style="@style/Widget.KirigenPlatform.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/background_card_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="AI EVALUATION REPORT"
                                android:textColor="@color/neon_cyan"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Score: 85%"
                                android:textColor="@color/neon_cyan"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_feedback_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Strong understanding of immutability!"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tv_feedback_tips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tip: Mention how 'val' corresponds to Java's final keyword under the hood to impress recruiters."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btn_next_question"
                            style="@style/Widget.KirigenPlatform.Button.Cyan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Next Question" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Final Scorecard View -->
            <LinearLayout
                android:id="@+id/layout_scorecard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="32dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_badge"
                    android:tint="@color/neon_cyan"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interview Completed!"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_final_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average Score: 88%"
                    android:textColor="@color/neon_cyan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Congratulations! You have unlocked the Android Foundations Micro-Credential badge."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="32dp" />

                <Button
                    android:id="@+id/btn_finish"
                    style="@style/Widget.KirigenPlatform.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Back to Workspace" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
