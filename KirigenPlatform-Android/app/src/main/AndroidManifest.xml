<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kirigenplatform">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KirigenPlatform"
        android:usesCleartextTraffic="true">
        
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="true"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar" />
        
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar" />
        
        <activity
            android:name=".ui.jobs.JobDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar" />
        
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="true"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar" />
        
        <activity
            android:name=".ui.connections.ConnectionsActivity"
            android:exported="true"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar" />
        
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="true"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar" />
        
        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="true"
            android:theme="@style/Theme.KirigenPlatform.NoActionBar" />
    </application>

</manifest>
