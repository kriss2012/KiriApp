generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FOUNDER
  INVESTOR
  MENTOR
  SERVICE_PROVIDER
  SPOC
  ADMIN
}

enum StudentLevel {
  R1
  R2
  R3
  R4
  R5
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  password         String
  fullName         String
  role             Role          @default(STUDENT)
  studentLevel     StudentLevel?
  department       String?
  college          String?
  year             String?
  section          String?
  isVerified       Boolean       @default(false)
  canCreateEvents  Boolean       @default(false)
  avatarUrl        String?
  bio              String?
  skills           String[]
  points           Int           @default(100) // Welcome points
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relationships
  jobsPosted       Job[]         @relation("JobsPosted")
  eventsCreated    Event[]       @relation("EventsCreated")
  messagesSent     Message[]     @relation("MessagesSent")
  messagesReceived Message[]     @relation("MessagesReceived")
  aiMessages       AiMessage[]
  conversations    Conversation[]
  sentRequests     Connection[]  @relation("SentRequests")
  receivedRequests Connection[]  @relation("ReceivedRequests")
  notifications    Notification[]
  activities       Activity[]
  pitches          Pitch[]
  backedPitches    Backer[]
  githubUrl        String?
  linkedInUrl      String?
  intent           String?   // "HIRING", "CO_FOUNDER", "INTERNSHIP", "MENTORSHIP"
  preferredLanguage String?  @default("ENGLISH") // "ENGLISH", "MARATHI", "HINDI"
  artifacts        ProjectArtifact[]
  expertise        String[]   // e.g. ["FINTECH", "UI", "BLOCKCHAIN"]
  mentorSessions   MentorSession[] @relation("MentorSessions")
  founderSessions  MentorSession[] @relation("FounderSessions")
  phoneNumber      String?
  website          String?
  services         String[]   // For Service Providers / Founders
}

model MentorSession {
  id          String   @id @default(uuid())
  mentorId    String
  mentor      User     @relation("MentorSessions", fields: [mentorId], references: [id])
  founderId   String
  founder     User     @relation("FounderSessions", fields: [founderId], references: [id])
  topic       String
  status      String   @default("PENDING") // PENDING, SCHEDULED, COMPLETED, CANCELLED
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
}

model ProjectArtifact {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String?  // Link to code/doc
  summary     String?  // AI Generated Summary
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "EVENT_JOIN", "CONNECTION", "AI_SESSION", "RECORD_CREATED"
  title     String
  content   String?
  points    Int      @default(10)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  type      String   // "EVENT", "REQUEST", "MESSAGE", "SYSTEM"
  relatedId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Connection {
  id          String           @id @default(uuid())
  status      ConnectionStatus @default(PENDING)
  senderId    String
  sender      User             @relation("SentRequests", fields: [senderId], references: [id])
  receiverId  String
  receiver    User             @relation("ReceivedRequests", fields: [receiverId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([senderId, receiverId])
}

model AiMessage {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  content        String
  role           String        // "user" or "assistant"
  createdAt      DateTime      @default(now())
}

model Conversation {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  title          String      @default("New Conversation")
  model          String      @default("google/gemini-2.0-flash-001")
  specialization String?     @default("GENERAL")
  isArchived     Boolean     @default(false)
  isPinned       Boolean     @default(false)
  messages       AiMessage[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String?
  type        String   @default("FULL_TIME")
  posterId    String
  poster      User     @relation("JobsPosted", fields: [posterId], references: [id])
  createdAt   DateTime @default(now())
}

model Message {
  id          String   @id @default(uuid())
  content     String
  senderId    String
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String
  type        String   @default("GENERAL")
  ownerId     String
  owner       User     @relation("EventsCreated", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
}

model Pitch {
  id          String   @id @default(uuid())
  title       String
  description String
  problem     String
  solution    String
  impact      String   // Regional Impact
  fundingGoal Float
  status      String   @default("OPEN") // OPEN, FUNDED, CLOSED
  category    String   @default("TECH")
  founderId   String
  founder     User     @relation(fields: [founderId], references: [id])
  backers     Backer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Backer {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  pitchId   String
  pitch     Pitch    @relation(fields: [pitchId], references: [id])
  points    Int      @default(10)
  createdAt DateTime @default(now())

  @@unique([userId, pitchId])
}

model InviteCode {
  id          String   @id @default(uuid())
  code        String   @unique
  targetRole  Role
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}
