generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FOUNDER
  INVESTOR
  MENTOR
  SERVICE_PROVIDER
  SPOC
  ADMIN
}

enum StudentLevel {
  R1
  R2
  R3
  R4
  R5
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  password         String
  fullName         String
  role             Role          @default(STUDENT)
  studentLevel     StudentLevel?
  department       String?
  college          String?
  year             String?
  section          String?
  isVerified       Boolean       @default(false)
  canCreateEvents  Boolean       @default(false)
  avatarUrl        String?
  bio              String?
  skills           String[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relationships
  jobsPosted       Job[]         @relation("JobsPosted")
  eventsCreated    Event[]       @relation("EventsCreated")
  messagesSent     Message[]     @relation("MessagesSent")
  messagesReceived Message[]     @relation("MessagesReceived")
  aiMessages       AiMessage[]
  conversations    Conversation[]
  sentRequests     Connection[]  @relation("SentRequests")
  receivedRequests Connection[]  @relation("ReceivedRequests")
  notifications    Notification[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  type      String   // "EVENT", "REQUEST", "MESSAGE", "SYSTEM"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Connection {
  id          String           @id @default(uuid())
  status      ConnectionStatus @default(PENDING)
  senderId    String
  sender      User             @relation("SentRequests", fields: [senderId], references: [id])
  receiverId  String
  receiver    User             @relation("ReceivedRequests", fields: [receiverId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([senderId, receiverId])
}

model AiMessage {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  content        String
  role           String        // "user" or "assistant"
  createdAt      DateTime      @default(now())
}

model Conversation {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  title      String      @default("New Conversation")
  model      String      @default("google/gemini-2.0-flash-001")
  isArchived Boolean     @default(false)
  isPinned   Boolean     @default(false)
  messages   AiMessage[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String?
  type        String   @default("FULL_TIME")
  posterId    String
  poster      User     @relation("JobsPosted", fields: [posterId], references: [id])
  createdAt   DateTime @default(now())
}

model Message {
  id          String   @id @default(uuid())
  content     String
  senderId    String
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String
  type        String   @default("GENERAL")
  ownerId     String
  owner       User     @relation("EventsCreated", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
}
