generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserCategory {
  STUDENT
  NON_STUDENT
  ALUMNI
  FACULTY
}

enum StakeholderType {
  FOUNDER
  SERVICE_PROVIDER
  MENTOR
  INVESTOR
  INCUBATOR
  GUEST
}

enum RepoCategory {
  R1
  R2
  R3
  R4
  R5
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostType {
  NEWS
  WALL_OF_FAME
  ASK
  PRODUCT
  ANNOUNCEMENT
}

enum InputFormat {
  TEXT
  VOICE
  VIDEO
  IMAGE
}

enum InputContext {
  DAY_TO_DAY
  ACHIEVEMENT
  FAILURE
  STUCK
  ASK_FOR_HELP
}

enum MatchStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
}

// --- CORE MODELS ---

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  password         String
  fullName         String
  userCategory     UserCategory  @default(STUDENT)
  refreshToken     String?       @map("refresh_token")
  digitalPersona   String?       @map("digital_persona") // AI Generated summary
  phoneNumber      String?       @unique
  avatarUrl        String?
  bio              String?
  department       String?
  college          String?
  year             String?
  section          String?
  website          String?
  githubUrl        String?
  linkedInUrl      String?
  portfolioUrl     String?
  rollNo           String?
  achievements     String?
  services         String[]      @default([])
  points           Int           @default(100)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Roles Mapping
  stakeholderRoles StakeholderRole[]
  
  // R1-R5 Repositories
  repositories     UserRepositoryMapping[]
  
  // AAL (Launchpad)
  aalOnboarding    AalOnboarding?
  aalActivities    AalActivity[]

  // AI Brain
  liveInputs       LiveInput[]
  sentMatches      AiResourceMatch[] @relation("MatchSource")
  receivedMatches  AiResourceMatch[] @relation("MatchTarget")

  // Legacy/Functional Relationships
  jobsPosted       Job[]         @relation("JobsPosted")
  eventsCreated    Event[]       @relation("EventsCreated")
  messagesSent     Message[]     @relation("MessagesSent")
  messagesReceived Message[]     @relation("MessagesReceived")
  aiMessages       AiMessage[]
  conversations    Conversation[]
  sentRequests     Connection[]  @relation("SentRequests")
  receivedRequests Connection[]  @relation("ReceivedRequests")
  notifications    Notification[]
  pitches          Pitch[]
  backedPitches    Backer[]
  boardPosts       EcosystemBoard[]
  
  // Missing relations for Prisma 7 validation
  institutions     Institution[]
  eventRegistrations EventRegistration[]
  committees       InstitutionalCommittee[]

  // Approval records (if this user is R5/SPOC)
  approvals        UserRepositoryMapping[] @relation("ApprovedBy")
  
  sentMentorSessions     MentorSession[] @relation("FounderSessions")
  receivedMentorSessions MentorSession[] @relation("MentorSessions")
}

model StakeholderRole {
  id       String          @id @default(uuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id])
  roleName StakeholderType
}

// --- INSTITUTIONAL HIERARCHY ---

model Institution {
  id          String   @id @default(uuid())
  name        String
  spocUserId  String?
  spoc        User?    @relation(fields: [spocUserId], references: [id])
  committees  InstitutionalCommittee[]
  repositories UserRepositoryMapping[]
  events      Event[]  @relation("HostInstitution")
}

model InstitutionalCommittee {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  department    String
  roleType      String      // 'FACULTY_REP' or 'STUDENT_REP'
}

model UserRepositoryMapping {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  institutionId  String
  institution    Institution    @relation(fields: [institutionId], references: [id])
  repoCategory   RepoCategory
  approvalStatus ApprovalStatus @default(PENDING)
  approvedById   String?
  approvedBy     User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
}

// --- APEX AI LAUNCHPAD (AAL) ---

model AalOnboarding {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  mindsetScore    Json?    @map("mindset_score")
  lmsStatus       String   @default("ENROLLED") // 'ENROLLED', 'COMPLETED'
  certificateUrl  String?  @map("certificate_url")
  interviewStatus String   @default("PENDING")  // 'PENDING', 'PASSED', 'FAILED'
}

model AalActivity {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  activityNumber Int      @map("activity_number")
  submissionUrl  String   @map("submission_url")
  status         String   @default("SUBMITTED") // 'SUBMITTED', 'VERIFIED'
  createdAt      DateTime @default(now())
}

// --- EVENTS & HACKATHONS ---

model Event {
  id                 String              @id @default(uuid())
  title              String
  description        String
  date               DateTime
  location           String
  imageUrl           String?
  type               String              @default("GENERAL") // 'MEETUP', 'HACKATHON', etc.
  coordinatorName    String?
  coordinatorPhone   String?
  registrationLink   String?
  prize              String?
  hostInstitutionId  String?
  hostInstitution    Institution?        @relation("HostInstitution", fields: [hostInstitutionId], references: [id])
  ownerId            String
  owner              User                @relation("EventsCreated", fields: [ownerId], references: [id])
  qrBaseUrl          String?             @map("qr_base_url")
  formSchema         Json?               @map("form_schema")
  registrations      EventRegistration[]
  teams              EventTeam[]
  submissions        EventSubmission[]
  judgingRecords     JudgingRecord[]
  createdAt          DateTime            @default(now())
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  status       String   @default("REGISTERED") // 'REGISTERED', 'WAITLIST', 'ATTENDED'
  formData     Json?    @map("form_data")
  qrScannedAt  DateTime? @map("qr_scanned_at")
  createdAt    DateTime @default(now())
}

model EventTeam {
  id           String            @id @default(uuid())
  eventId      String
  event        Event             @relation(fields: [eventId], references: [id])
  teamName     String            @map("team_name")
  aiGenerated  Boolean           @default(false) @map("ai_generated")
  submissions  EventSubmission[]
  judgingRecords JudgingRecord[]
}

model EventSubmission {
  id                   String   @id @default(uuid())
  eventId              String
  event                Event    @relation(fields: [eventId], references: [id])
  teamId               String?
  team                 EventTeam? @relation(fields: [teamId], references: [id])
  documentUrl          String   @map("document_url")
  geoLat               Decimal? @map("geo_lat")
  geoLong              Decimal? @map("geo_long")
  aiAuthenticityScore  Float?   @map("ai_authenticity_score")
  createdAt            DateTime @default(now())
}

model JudgingRecord {
  id            String     @id @default(uuid())
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id])
  teamId        String
  team          EventTeam  @relation(fields: [teamId], references: [id])
  judgeUserId   String?
  isAiJudge     Boolean    @default(false) @map("is_ai_judge")
  score         Float
  feedback      String?
  createdAt     DateTime   @default(now())
}

// --- AI CORE ---

model LiveInput {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  formatType  InputFormat @map("format_type")
  contentUrl  String      @map("content_url")
  context     InputContext
  aiProcessed Boolean     @default(false) @map("ai_processed")
  createdAt   DateTime    @default(now())
}

model AiResourceMatch {
  id           String      @id @default(uuid())
  sourceUserId String      @map("source_user_id")
  sourceUser   User        @relation("MatchSource", fields: [sourceUserId], references: [id])
  targetUserId String      @map("target_user_id")
  targetUser   User        @relation("MatchTarget", fields: [targetUserId], references: [id])
  matchReason  String      @map("match_reason")
  status       MatchStatus @default(SUGGESTED)
  createdAt    DateTime    @default(now())
}

// --- ECOSYSTEM BOARD ---

model EcosystemBoard {
  id           String   @id @default(uuid())
  authorUserId String   @map("author_user_id")
  author       User     @relation(fields: [authorUserId], references: [id])
  postType     PostType @map("post_type")
  title        String
  description  String
  mediaUrl     String?  @map("media_url")
  createdAt    DateTime @default(now())
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String?
  type        String   @default("JOB") // 'JOB', 'INTERNSHIP', 'RESEARCH', 'CASE_STUDY'
  posterId    String
  poster      User     @relation("JobsPosted", fields: [posterId], references: [id])
  status      String   @default("OPEN") // 'OPEN', 'CLOSED'
  createdAt   DateTime @default(now())
}

// --- LEGACY/UTILITY MODELS ---

model Connection {
  id          String   @id @default(uuid())
  status      String   @default("PENDING")
  senderId    String
  sender      User     @relation("SentRequests", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id])
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Message {
  id          String   @id @default(uuid())
  content     String
  senderId    String
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  type      String
  relatedId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AiMessage {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  content        String
  role           String
  createdAt      DateTime      @default(now())
}

model Conversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  title     String      @default("New Conversation")
  messages  AiMessage[]
  createdAt DateTime    @default(now())
}

model Pitch {
  id          String   @id @default(uuid())
  title       String
  description String
  problem     String
  solution    String
  impact      String
  fundingGoal Float
  status      String   @default("OPEN")
  founderId   String
  founder     User     @relation(fields: [founderId], references: [id])
  backers     Backer[]
  createdAt   DateTime @default(now())

  @@index([founderId])
}

model Backer {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  pitchId   String
  pitch     Pitch    @relation(fields: [pitchId], references: [id])
  points    Int      @default(10)
  createdAt DateTime @default(now())
}

model MentorSession {
  id          String    @id @default(uuid())
  mentorId    String
  mentor      User      @relation("MentorSessions", fields: [mentorId], references: [id])
  founderId   String
  founder     User      @relation("FounderSessions", fields: [founderId], references: [id])
  topic       String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([mentorId])
  @@index([founderId])
}
