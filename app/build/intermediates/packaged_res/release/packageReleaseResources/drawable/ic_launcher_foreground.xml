<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Shadow/Glow Layer -->
    <path
        android:pathData="M34,74 L54,28 L74,74 L66,74 L54,46 L42,74 Z"
        android:fillColor="#22F26522" />

    <!-- Main ASG "A" Shape with Premium Gradient -->
    <path
        android:pathData="M30,70 L54,24 L78,70 L68,70 L54,42 L40,70 Z">
        <gradient
            android:startY="24"
            android:startX="54"
            android:endY="70"
            android:endX="54"
            android:type="linear">
            <item android:offset="0" android:color="#FFF26522" /> <!-- APEX Orange -->
            <item android:offset="1" android:color="#FFD94D08" /> <!-- Deep Orange -->
        </gradient>
    </path>

    <!-- Glass Highlight / Shimmer Layer -->
    <path
        android:pathData="M54,24 L78,70 L68,70 L54,42 Z"
        android:fillColor="#33FFFFFF" />

    <!-- Stylized "S" curve hint -->
    <path
        android:pathData="M48,55 Q54,50 60,55"
        android:strokeWidth="2"
        android:strokeColor="#44FFFFFF"
        android:strokeLineCap="round" />

</vector>
